# --- Server ---
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Neon or Supabase) ---
# Pooled — used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?pgbouncer=true&connection_limit=1"
# Direct — used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST-DIRECT:5432/DBNAME"

# --- JWT (RS256) ---
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (optional at launch) ---
REDIS_URL=redis://localhost:6379

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Election Campaign OS <no-reply@example.com>"

# --- SMS Gateway (OTP) ---
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# --- reCAPTCHA v3 ---
RECAPTCHA_SECRET_KEY=

# --- AI provider (Part 2: readiness recommendations, campaign planner, AI tools hub) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_COST_PER_1K_INPUT_TOKENS_INR=0.15
AI_COST_PER_1K_OUTPUT_TOKENS_INR=0.60
AI_MONTHLY_QUOTA_INR=500
